{
  "name": "toolhub-backend",
  "version": "1.0.0",
  "description": "ToolHub India B2B eShop — Express 5 REST API (catalog, auth, cart, checkout, imports, admin).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:circ": "madge --extensions ts --circular src",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"tests/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "pretest": "node scripts/migrate-test-db.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:studio": "prisma studio",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "mail:preview": "tsx scripts/preview-mail.ts",
    "prepare": "husky || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fast-csv": "^5.0.8",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.18.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "madge": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@scarf/scarf": false
  }
}
