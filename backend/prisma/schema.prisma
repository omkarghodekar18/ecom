// ToolHub India — database schema
// Spec Section 8, kept verbatim; additions required by Sections 11–13 are
// marked with `// [addition]` and documented in docs/adr/0003-schema-additions.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserType {
  B2B
  B2C
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttrType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
}

enum FilterWidget {
  CHECKBOX
  RANGE
  DROPDOWN
}

enum ImageKind {
  PHOTO
  DRAWING
  TECHNICAL
  OTHER
}

enum DocKind {
  DATASHEET
  CAD
  MANUAL
  CERTIFICATE
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum ImportStatus {
  UPLOADED
  PARSING
  VALIDATING
  VALIDATED_WITH_ERRORS
  READY_TO_COMMIT
  COMMITTING
  COMPLETED
  FAILED
  ROLLED_BACK
  CANCELLED
}

enum IssueSeverity {
  ERROR
  WARNING
}

enum BannerPlacement {
  HOME_HERO
  HOME_SIDE_TOP
  HOME_SIDE_BOTTOM
  HOME_HIGHLIGHT
  MENU_TEASER
}

// [addition] Section 13.6: 301 redirects on slug changes
enum RedirectType {
  CATEGORY
  PRODUCT
  CMS
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  role            Role      @default(CUSTOMER)
  type            UserType  @default(B2B)
  firstName       String
  lastName        String
  phone           String?
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  refreshTokens   RefreshToken[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
}

model Company {
  id             String          @id @default(cuid())
  name           String
  gstin          String?
  customerNumber String?         @unique
  users          User[]
  customerPrices CustomerPrice[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OtpCode {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Address {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String?
  contactName       String
  phone             String
  line1             String
  line2             String?
  city              String
  state             String
  postalCode        String
  country           String  @default("IN")
  gstin             String?
  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  @@index([userId]) // [addition] FK index (Section 17)
}

model Category {
  id            String            @id @default(cuid())
  code          String            @unique
  slug          String
  name          String
  description   String?
  parentId      String?
  parent        Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]        @relation("CategoryTree")
  path          String
  pathSlugs     String
  level         Int
  sortOrder     Int               @default(0)
  imagePublicId String?
  iconPublicId  String?
  productCount  Int               @default(0)
  isActive      Boolean           @default(true)
  seoTitle      String?
  seoDescription String?
  products      Product[]
  attributes    CategoryAttribute[]
  deletedAt     DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([parentId, sortOrder])
  @@index([path])
  @@index([slug])
}

model Brand {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String    @unique
  logoPublicId String?
  badgeColor   String?
  description  String?
  isPremium    Boolean   @default(false)
  products     Product[]
}

model AttributeDefinition {
  id        String                  @id @default(cuid())
  key       String                  @unique
  label     String
  labelHtml String?
  groupName String
  type      AttrType
  unit      String?
  enumValues Json?
  categories CategoryAttribute[]
  values    ProductAttributeValue[]
}

model CategoryAttribute {
  categoryId    String
  attributeId   String
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute     AttributeDefinition  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isRequired    Boolean             @default(false)
  isFilterable  Boolean             @default(true)
  isVariantAxis Boolean             @default(false)
  filterWidget  FilterWidget        @default(CHECKBOX)
  sortOrder     Int                 @default(0)

  @@id([categoryId, attributeId])
}

model Product {
  id               String                @id @default(cuid())
  slug             String                @unique
  name             String
  brandId          String
  brand            Brand                 @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category              @relation(fields: [categoryId], references: [id])
  shortDescription String?
  descriptionHtml  String?
  isBestseller     Boolean               @default(false)
  status           ProductStatus         @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  minPrice         Decimal?              @db.Decimal(12, 2) // [addition] Section 17 denormalised price-from
  searchVector     Unsupported("tsvector")?
  variants         Variant[]
  images           ProductImage[]
  documents        ProductDocument[]
  deletedAt        DateTime?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, isBestseller])
}

model Variant {
  id              String                 @id @default(cuid())
  productId       String
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  articleNo       String                 @unique
  ean             String?                @unique
  name            String?
  listPrice       Decimal                @db.Decimal(12, 2)
  currency        String                 @default("INR")
  priceUnit       Int                    @default(1)
  unitLabel       String                 @default("Piece")
  taxClass        String                 @default("STANDARD")
  stockQty        Int                    @default(0)
  leadTimeMinDays Int?
  leadTimeMaxDays Int?
  minOrderQty     Int                    @default(1)
  packSize        Int                    @default(1)
  isActive        Boolean                @default(true)
  attributes      ProductAttributeValue[]
  priceTiers      PriceTier[]
  customerPrices  CustomerPrice[]
  cartItems       CartItem[]
  images          ProductImage[]
  sortOrder       Int                    @default(0)
  deletedAt       DateTime?

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([productId, sortOrder])
  @@index([listPrice])
  @@index([ean]) // [addition] exact EAN lookups (Section 12)
}

model ProductAttributeValue {
  id           String              @id @default(cuid())
  variantId    String
  variant      Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id])
  valueString  String?
  valueNumber  Decimal?            @db.Decimal(18, 6)
  valueBool    Boolean?

  @@unique([variantId, attributeId, valueString])
  @@index([attributeId, valueString])
  @@index([attributeId, valueNumber])
  @@index([variantId])
}

model PriceTier {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQty    Int
  price     Decimal @db.Decimal(12, 2)

  @@unique([variantId, minQty])
}

model CustomerPrice {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price     Decimal   @db.Decimal(12, 2)
  validFrom DateTime?
  validTo   DateTime?

  @@unique([companyId, variantId])
  @@index([variantId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  publicId  String
  kind      ImageKind @default(PHOTO)
  alt       String?
  sortOrder Int      @default(0)

  @@index([productId, sortOrder])
}

model ProductDocument {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      DocKind
  title     String
  url       String
  publicId  String?
  sizeBytes Int?

  @@index([productId])
}

model Cart {
  id              String     @id @default(cuid())
  userId          String?
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousToken  String?    @unique
  currency        String     @default("INR")
  items           CartItem[]
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  note      String?

  @@unique([cartId, variantId])
  @@index([variantId]) // [addition] FK index (Section 17)
}

model Order {
  id             String        @id @default(cuid())
  orderNo        String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  String
  shippingAddress Json
  billingAddress Json
  poNumber       String?
  notes          String?
  /// [addition] place-order idempotency (spec Section 9: idempotency key support)
  idempotencyKey String?        @unique
  events         OrderEvent[]
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  shippingTotal  Decimal       @db.Decimal(12, 2)
  grandTotal     Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String?
  articleNo         String
  name              String
  attributesSnapshot Json?
  imagePublicId     String?
  unitPrice         Decimal  @db.Decimal(12, 2)
  quantity          Int
  lineTotal         Decimal  @db.Decimal(12, 2)

  @@index([orderId]) // [addition] FK index (Section 17)
}

model Banner {
  id            String          @id @default(cuid())
  placement     BannerPlacement
  eyebrow       String?
  heading       String
  subheading    String?
  ctaLabel      String?
  ctaHref       String?
  imagePublicId String
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
}

model CmsPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  blocks         Json
  seoTitle       String?
  seoDescription String?
  status         ProductStatus @default(DRAFT)
  updatedAt      DateTime      @updatedAt
}

model ImportJob {
  id           String       @id @default(cuid())
  type         String
  status       ImportStatus @default(UPLOADED)
  fileName     String
  filePublicId String?
  fileSha256   String
  mode         String
  options      Json?
  stats        Json?
  createdById  String
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
  issues       ImportIssue[]

  @@index([createdById, createdAt])
}

model ImportIssue {
  id        String        @id @default(cuid())
  jobId     String
  job       ImportJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sheet     String
  rowNumber Int
  column    String?
  severity  IssueSeverity
  code      String
  message   String
  rawValue  String?

  @@index([jobId, severity])
}

model ImportBatchItem {
  id         String    @id @default(cuid())
  jobId      String
  entity     String
  entityId   String
  action     String
  previous   Json?

  @@index([jobId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model SearchQueryLog {
  id          String   @id @default(cuid())
  q           String
  resultCount Int
  createdAt   DateTime @default(now())
}

// ── [addition] Models required by Sections 11–13 ────────────────────────────

/// 301 map for changed slugs (Section 13.6)
model SlugRedirect {
  id        String       @id @default(cuid())
  type      RedirectType
  oldPath   String       @unique
  newPath   String
  createdAt DateTime     @default(now())
}

/// Key/value runtime settings managed by the admin Settings section
/// (tax rate, shipping rules, stock policy, feature flags — Section 11/15.9)
model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

/// [addition] Status timeline per order (spec 6.9 "status timeline"): one row
/// per transition incl. the initial placement; powers the customer timeline and
/// the admin status state machine (spec Section 15.6).
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

/// Per-year counter backing ORD-YYYY-NNNNNN order numbers (Section 11)
model OrderSequence {
  year        Int @id
  lastNumber Int @default(0)
}

/// Auth event stream: brute-force lockout + audit of auth events (Section 10)
model AuthEvent {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  kind      String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}
