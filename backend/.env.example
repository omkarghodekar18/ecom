# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public origin of this API (used for emails, OpenAPI server URL). No trailing slash.
PUBLIC_API_URL=http://localhost:4000
# Comma-separated CORS allow-list (origins). Entries are exact origins or
# patterns with `*` wildcards, e.g. https://preview-*.example.com (matches
# https://preview-anything.example.com). The dev frontend origin is included
# by default.
CORS_ORIGINS=http://localhost:3000
# Bearer token protecting POST /api/revalidate on the frontend (must match frontend REVALIDATE_SECRET)
REVALIDATE_SECRET=change-me-revalidate-secret
# Frontend base URL the revalidation worker POSTs ISR tags to
FRONTEND_INTERNAL_URL=http://localhost:3000

# ─── Database (PostgreSQL; works with any hosted Postgres, e.g. Supabase) ──
# Connection string for runtime (possibly pooled, e.g. pgBouncer).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toolhub
# Direct (non-pooled) connection for migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/toolhub

# ─── Auth / crypto ─────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-at-least-32-chars-long-secret
JWT_REFRESH_SECRET=change-me-another-at-least-32-char-secret
# HMAC key for OTP codes and cart/anonymous tokens
HMAC_SECRET=change-me-hmac-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Optional: URL of a breached-password endpoint (e.g. a local k-anonymity proxy). Empty = disabled.
BREACHED_PASSWORD_CHECK_URL=

# ─── Mail (SMTP via nodemailer; MAIL_PROVIDER=file writes to var/outbox for dev)
MAIL_PROVIDER=file
SMTP_URL=smtp://user:pass@localhost:1025
MAIL_FROM="ToolHub India <no-reply@toolhub.example>"

# ─── Background jobs (pg-boss, Postgres-backed) ────────────────────────────
QUEUE_ENABLED=true

# ─── Storage / media ───────────────────────────────────────────────────────
# cloudinary (needs keys) or local (dev: files under var/uploads served at /media)
STORAGE_ADAPTER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional CDN base for the NEXT loader when Cloudinary is active
CLOUDINARY_SECURE_DISTRIBUTION=

# ─── Payments ──────────────────────────────────────────────────────────────
# invoice | razorpay | mock  (provider behind PaymentProvider abstraction)
PAYMENT_PROVIDER=invoice
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Seed ──────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!secure

# ─── Load tests (optional) ──────────────────────────────────────────────────
# General API rate limit per minute and IP (default 300). Raise only for
# load-test runs, e.g. API_RATE_LIMIT=100000 — never in production.
API_RATE_LIMIT=300
