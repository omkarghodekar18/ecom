# ─── URLs ───────────────────────────────────────────────────────────────────
# Public origin of this frontend (used for canonical URLs, sitemaps, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL the browser uses to reach the backend API. "/api/v1" keeps calls
# same-origin; Next.js rewrites them to the backend (works behind CDNs).
NEXT_PUBLIC_API_URL=/api/v1
# Internal URL server components / route handlers use to call the backend
# directly (no rewrite hop).
BACKEND_INTERNAL_URL=http://localhost:4000

# ─── Media ──────────────────────────────────────────────────────────────────
# Empty = local adapter: images are served by the backend at /media/...
# (dev). Set the Cloudinary cloud name to switch to the Cloudinary CDN.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_SECURE_DISTRIBUTION=

# ─── Revalidation webhook ───────────────────────────────────────────────────
# Must match backend REVALIDATE_SECRET
REVALIDATE_SECRET=change-me-revalidate-secret
