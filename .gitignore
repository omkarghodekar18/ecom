backend/dist/
frontend/.next/
*.tsbuildinfo

# Runtime artifacts
backend/var/
backend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
*.log

# Workspace artifacts (not part of the product)
tool-results/
agent-ctx/
download/
skills/

# OS
.DS_Store
